# Copy to .env and fill in. All values are optional — the public JSON API
# (used by the fetch helpers and the *_public MCP tools) needs no credentials.
#
# MaStR Webdienst credentials unlock the 14 SOAP tools in the MCP server
# (unit details, delta sync, catalogs, ...). Register at
# https://www.marktstammdatenregister.de -> Webdienst.
MASTR_USER=
MASTR_TOKEN=

# Optional: override where fetched data is stored (default: ./data)
# MASTR_DATA_DIR=
